<Project Sdk="Microsoft.NET.Sdk">

    <!-- The library both engines reference from their own projects, which knows no engine (N 2.1).
         The assembly and the package take the 3DEngine prefix, which makes the name unique, and the
         namespace stays the module's own. -->
    <PropertyGroup>
        <AssemblyName>3DEngine.RadianceCascades</AssemblyName>
        <PackageId>3DEngine.RadianceCascades</PackageId>
        <RootNamespace>RadianceCascades</RootNamespace>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <!-- Every public member has a summary (STYLE.md), so a missing one stops the build, as a cref that
         names nothing does. -->
    <PropertyGroup>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <WarningsAsErrors>$(WarningsAsErrors);CS1591;CS1574</WarningsAsErrors>
    </PropertyGroup>

</Project>
